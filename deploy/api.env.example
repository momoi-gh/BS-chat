# 复制为 .env.prod 并替换所有 CHANGE_ME
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# 容器内通过 compose 网络访问数据库
DATABASE_URL=postgres://bs:CHANGE_ME@bs-postgres:5432/bs_chat

# 至少 32 字符，用 openssl rand -hex 32 生成
JWT_SECRET=CHANGE_ME_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_32_CHARS

CORS_ORIGIN=https://chat.example.com
LOG_LEVEL=info
