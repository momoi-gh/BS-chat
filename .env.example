# 运行环境：development / test / production
NODE_ENV=development

# 监听地址与端口（rootless 容器只能绑定 >= 1024）
HOST=127.0.0.1
PORT=3000

# PostgreSQL 容器初始化参数（DATABASE_URL 必须与这里保持一致）
POSTGRES_USER=bs
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bs_chat

# PostgreSQL 连接串
DATABASE_URL=postgres://bs:change-me@127.0.0.1:5432/bs_chat

# JWT 密钥：至少 32 字符，生产环境务必替换
# 生成方式：openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters

# 允许的前端来源
CORS_ORIGIN=http://localhost:5173

# 日志级别：fatal / error / warn / info / debug / trace / silent
LOG_LEVEL=info
